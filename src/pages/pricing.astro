---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import { SITE } from '../site';
import { PLANS, INCLUDED } from '../data/plans';
import { trialAvailable } from '../data/release';

const released = SITE.stage === 'released';

// Allowances as rolls of 36, so a photographer can place themselves without counting frames
const frames = (n: number) => n.toLocaleString('en-GB');
const rolls = (n: number) => { const r = n / 36; return r >= 50 ? Math.round(r / 10) * 10 : Math.round(r); };

// Before release a plan's button leads to the trial if there is one, else early access
const preCta = trialAvailable
  ? { href: '/download/', label: 'Try it free' }
  : { href: '#early-access', label: 'Request early access' };

// How the allowance is counted: the design in negacon-converter NEXT_BUILD_TODO §4
const ALLOWANCE = [
  ['A frame counts once a month.', 'Re-exporting it, or exporting it as both TIFF and JPEG, doesn’t count again.'],
  ['An export that has started always finishes.', 'The allowance is checked before an export starts, with a margin of up to 40 frames so the last roll of a month can be finished.'],
  ['Nothing else stops.', 'Opening, grading and calibrating carry on at the limit.'],
  ['You can see where you are.', 'Help → Licence shows the frames you’ve used this month and when the count starts again.'],
];

const FAQ = [
  ['How is Obelisk priced?', `By how many frames you export each month. Every plan includes every feature, so a photographer’s scans convert exactly as a lab’s do; plans differ in their monthly allowance and the support that comes with them.${released ? '' : ' Prices are announced at release.'}`],
  ...(released ? [
    ['What does a Personal licence include?', 'Every feature, for one person on up to two computers: 500 exported frames a month and a year of updates, for €99 once, including VAT. Every version released during that year keeps working with your licence for good.'],
    ['How do I get my licence?', 'By email, within one working day of your order. It is a small file: open Obelisk, choose Help → Licence… and load it. Anything you have already done in the trial stays as it is.'],
    ['Does Obelisk need an internet connection?', 'Only briefly. Obelisk confirms your licence online when it starts and needs to reach our licence server at least once every 30 days. Conversion itself runs entirely on your computer, and your images are never sent anywhere.'],
    ['What happens after the year of updates?', 'Obelisk keeps working with every version released during your year. Newer versions need a renewed licence.'],
  ] : []),
  ['Which platforms does it run on?', 'Windows 10 and 11, 64-bit, and macOS 14 or later on Apple silicon (M1 and later).'],
  ...(trialAvailable ? [['Can I try it first?', `Yes. Obelisk runs free for ${SITE.trialDays} days from its first launch, with every feature except export. Download it from the Download page.`]] : []),
  ['Which cameras work?', 'Obelisk reads RAW files from most current camera bodies. The camera is part of the calibration, so a profile is made for the camera and light you actually scan with.'],
  ['Do I need an RGB light source?', 'No. White light — an LED panel or light table — works, because calibration is measured for whichever light you use. Narrowband RGB extracts somewhat more colour separation from the same negative, and separate red, green and blue exposures (trichrome) more again; Obelisk merges those into one raw file per frame.'],
  ['What do I need to calibrate a film stock?', 'A standard colour chart, one roll of the stock to photograph it on in a one-stop bracket, and about five minutes at the scanning station once it is developed. Once per stock and light source.'],
  ['Do I have to calibrate every stock I scan?', 'No. Lab auto converts colour negative film with no profile, using a generic film for your type of scanning light. Calibrate the stocks you scan most: a calibrated profile is what converts a roll identically every time.'],
  ['Which films are supported?', 'Colour negative (C-41 and ECN-2) and black & white negative. Slide film is not supported.'],
  ['Do my images leave my computer?', 'No. Conversion and automatic orientation run entirely on your machine. Customer images are never uploaded.'],
  ['What happens to my work if I stop using Obelisk?', 'Your exports are standard TIFF and JPEG files, and every grading decision is written beside the scans in the roll folder rather than locked inside the application.'],
];
---
<Base title="Pricing and plans" description="Obelisk plans differ only in how many frames you export each month: affordable for photographers scanning their own film, fairly priced for labs. Every plan includes every feature.">
  <PageHero
    eyebrow={released ? 'Pricing' : 'Pricing & early access'}
    title="Priced by how much you scan."
    lede={released
      ? 'Every plan includes every feature. Plans differ only in how many frames you export each month, and the support that comes with them.'
      : 'Obelisk is meant to be affordable for photographers scanning their own film, and fairly priced for labs that scan for a living. Every plan includes every feature; plans differ only in how many frames you export each month. Prices are announced at release.'}
  >
    {released && trialAvailable && (
      <div class="ph-cta">
        <a class="btn btn-primary" href="/download/">Download free trial <span class="arrow">→</span></a>
        <span class="muted small">{SITE.trialDays} days, every feature except export.</span>
      </div>
    )}
  </PageHero>

  <section class="wrap plans">
    {PLANS.map((p) => (
      <div class="plan card">
        <h2>{p.name}</h2>
        <p class="muted small">{p.for}</p>
        <div class="allow">
          <span class="amt">{p.allowance === null ? 'Unlimited' : frames(p.allowance)}</span>
          <span class="allow-k data">frames a month</span>
          <span class="muted small">{p.allowance === null ? 'No monthly limit' : `About ${rolls(p.allowance)} rolls of 36`}</span>
        </div>
        <div class="price">
          {!released
            ? <span class="muted">Price at release</span>
            : p.price !== null
              ? <><span class="price-amt">{p.price}</span>{p.priceNote && <span class="muted small"> {p.priceNote}</span>}</>
              : <span class="muted">Contact for pricing</span>}
        </div>
        <p class="scope data">{p.scope}</p>
        <ul>{p.extras.map((f) => <li>{f}</li>)}</ul>
        {released
          ? <a class="btn btn-ghost" href={p.checkout || '#contact'}>{p.checkout ? `Choose ${p.name}` : 'Get in touch'}</a>
          : <a class="btn btn-ghost" href={preCta.href}>{preCta.label}</a>}
      </div>
    ))}
  </section>
  {!released && (
    <p class="wrap plans-note muted small">Allowances are working figures and may change before release.</p>
  )}
  {released && (
    <p class="wrap plans-note muted small">
      Prices include VAT. Personal licences arrive by email within one working day
      (<a href="/licence-terms/">licence terms</a>).
      {trialAvailable && <> Not sure yet? <a href="/download/">Try Obelisk free for {SITE.trialDays} days</a> — every feature except export.</>}
    </p>
  )}

  <section class="wrap allow-wrap">
    <div class="allow-grid">
      <div>
        <p class="eyebrow">Why volume</p>
        <h2 class="h-sub">One instrument, sized by how much you scan.</h2>
        <p class="allow-why">
          Pricing by features would mean selling a worse conversion to whoever pays less. Every
          plan gets the same calibration, the same Lab auto and the same tools, so your scans
          are converted exactly as a lab’s are. What changes is volume: a photographer scanning a
          few rolls a month shouldn’t pay what a lab scanning hundreds does.
        </p>
      </div>
      <dl class="allow-how">
        {ALLOWANCE.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="wrap included-wrap">
    <div class="included card">
      <div>
        <p class="eyebrow">Every licence includes</p>
        <h2 class="h-sub">The whole instrument. No feature tiers on image quality.</h2>
      </div>
      <ul>{INCLUDED.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="wrap ea-wrap" id="contact">
    <span id="early-access"></span>
    <div class="ea-grid">
      {released ? (
        <div>
          <p class="eyebrow">Professionals and labs</p>
          <h2 class="h-section">Scanning for clients?</h2>
          <p class="lede" style="margin-top:18px">
            Professional and Lab plans are set up with you. Tell us about your rig and how much
            you scan, and we will get back to you with pricing.
          </p>
          <ul class="ea-points">
            <li>Help calibrating the stocks you scan on your rig</li>
            <li>Direct line to the developer</li>
          </ul>
        </div>
      ) : (
        <div>
          <p class="eyebrow">Early access</p>
          <h2 class="h-section">Scan with Obelisk before release.</h2>
          <p class="lede" style="margin-top:18px">
            We are onboarding a small group first, so each rig can be calibrated properly and every
            rough edge gets fixed before general release.
          </p>
          <ul class="ea-points">
            <li>Help calibrating your first stocks on your rig</li>
            <li>Direct line to the developer</li>
            <li>A say in what ships in the first release</li>
          </ul>
        </div>
      )}
      <div class="card ea-card"><EarlyAccess mode={released ? 'contact' : 'early'} /></div>
    </div>
  </section>

  <section class="wrap faq-wrap">
    <h2 class="h-section">Questions</h2>
    <div class="faq">
      {FAQ.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-top: 56px; }
  .plan { padding: 30px 26px; position: relative; display: flex; flex-direction: column; }
  .plan h2 { font-size: 24px; margin-bottom: 6px; }
  .allow { display: flex; flex-direction: column; gap: 4px; margin: 24px 0 0; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .amt { font-size: 40px; font-weight: 650; letter-spacing: -.03em; line-height: 1.1; }
  .allow-k { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .price { margin: 18px 0 4px; font-size: 15px; }
  .price-amt { font-size: 26px; font-weight: 650; letter-spacing: -.02em; }
  .scope { font-size: 13px; margin-bottom: 18px; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 10px; flex: 1; }
  .plan li, .included li { padding-left: 24px; position: relative; color: var(--text-2); font-size: 15px; }
  .plan li::before, .included li::before { content: '✓'; position: absolute; left: 0; color: var(--cyan); }
  @media (max-width: 900px) { .plans { grid-template-columns: 1fr; } }
  .plans-note { margin-top: 14px; }
  .ph-cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 30px; }

  .allow-wrap { padding-top: clamp(56px, 7vw, 88px); }
  .allow-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .allow-why { color: var(--text-2); margin-top: 18px; }
  .allow-how { margin: 0; display: grid; gap: 12px; }
  .allow-how > div { padding: 16px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .allow-how dt { color: var(--text); font-weight: 600; }
  .allow-how dd { margin: 2px 0 0; color: var(--muted); font-size: 15.5px; }
  @media (max-width: 900px) { .allow-grid { grid-template-columns: 1fr; } }

  .included-wrap { padding-top: 56px; }
  .included { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; padding: clamp(26px, 4vw, 44px); align-items: center; }
  .included ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  @media (max-width: 820px) { .included { grid-template-columns: 1fr; gap: 24px; } }

  .ea-wrap { padding-top: clamp(72px, 9vw, 112px); scroll-margin-top: 80px; }
  #early-access { display: block; scroll-margin-top: 80px; }   /* old links still land here */
  .ea-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .ea-points { list-style: none; padding: 0; margin: 26px 0 0; display: grid; gap: 12px; }
  .ea-points li { padding-left: 26px; position: relative; color: var(--text-2); }
  .ea-points li::before { content: ''; position: absolute; left: 0; top: 11px; width: 14px; height: 2px; background: var(--split); }
  .ea-card { padding: clamp(22px, 3vw, 34px); }
  @media (max-width: 900px) { .ea-grid { grid-template-columns: 1fr; } }

  .faq-wrap { padding: clamp(72px, 9vw, 112px) var(--gutter) 110px; max-width: 900px; }
  .faq { margin-top: 28px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font-weight: 600; font-size: 17.5px; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font: 400 24px/1 var(--font); color: var(--muted); transition: transform .2s; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details p { color: var(--muted); padding: 0 40px 22px 0; margin: 0; }
</style>
