---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1 class="h-section">This frame didn’t make it onto the roll.</h1>
    <p class="lede">The page you were looking for doesn’t exist or has moved.</p>
    <a class="btn btn-primary" href="/">Back to the home page <span class="arrow">→</span></a>
  </section>
</Base>
<style>
  .nf { padding: 140px var(--gutter) 160px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
</style>
