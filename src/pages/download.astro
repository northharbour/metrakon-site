---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, contactEmail } from '../site';
import { RELEASE, downloadHref, releasesPage } from '../data/release';

const days = SITE.trialDays;
const rel = RELEASE.state === 'ready' ? RELEASE.release : null;
const none = RELEASE.state === 'none';
const PLATFORMS = [
  { os: 'macOS', req: 'macOS 14 or later, Apple silicon (M1 and later)', asset: rel?.mac },
  { os: 'Windows', req: 'Windows 10 and 11, 64-bit', asset: rel?.win },
];
---
<Base title="Download" description={`Download Obelisk for macOS and Windows and use it free for ${days} days.`}>
  <PageHero
    eyebrow="Download"
    title={`Try Obelisk free for ${days} days.`}
    lede="Every feature works in the trial except export: convert, grade and compare your own rolls, with Lab auto or with stocks you calibrate yourself. Saving TIFF and JPEG files needs a licence."
  />

  {none ? (
    <section class="wrap dl-wrap soon-wrap">
      <div class="card soon">
        <h2 class="h-sub">The first public build is on its way.</h2>
        <p class="muted">Request early access and we will tell you when it is ready.</p>
        <a class="btn btn-primary" href="/pricing/#early-access">Request early access <span class="arrow">→</span></a>
      </div>
    </section>
  ) : (
    <>
      <section class="wrap dl-wrap">
        <div class="dl-grid">
          {PLATFORMS.map((p) => (
            <div class="card dl">
              <h2>{p.os}</h2>
              <p class="muted small">{p.req}</p>
              {p.asset || !rel
                ? <a class="btn btn-primary" href={downloadHref(p.asset)}>Download for {p.os} <span class="arrow">↓</span></a>
                : <p class="muted soon-line">Coming soon</p>}
              {p.asset && <p class="file data">{p.asset.name} · {p.asset.mb} MB</p>}
            </div>
          ))}
        </div>
        <p class="muted small rel-line">
          {rel && <>Version <span class="data">{rel.version}</span>{rel.date && <>, released {rel.date}</>}. </>}
          <a href={releasesPage}>All versions and release notes</a>. Downloads are served from GitHub.
        </p>
      </section>

      <section class="wrap info">
        <div class="info-grid">
          <div class="card info-card">
            <p class="eyebrow">Install</p>
            <h3>macOS</h3>
            <p>Open the disk image and drag Obelisk to Applications. If macOS says on first
              launch that it cannot verify the app, open System Settings → Privacy &amp;
              Security and click Open Anyway.</p>
            <h3>Windows</h3>
            <p>Run the installer. If Windows shows “Windows protected your PC”, click More
              info → Run anyway.</p>
          </div>
          <div class="card info-card">
            <p class="eyebrow">The trial</p>
            <ul class="points">
              <li>{days} days from the first launch</li>
              <li>Every conversion feature: Lab auto, calibration, live grading, the whole
                roll workflow</li>
              <li>Scans and grading stay on your computer</li>
            </ul>
            <p class="lic">Export — TIFF and JPEG files and contact sheets — needs a licence.
              After {days} days Obelisk asks for one. Load it in Help → Licence…; your rolls
              and grading are kept.
              {contactEmail() && <> To get a licence, write to <a href={`mailto:${contactEmail()}`}>{contactEmail()}</a>.</>}</p>
          </div>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .dl-wrap { padding-top: 56px; }
  .dl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .dl { padding: 30px 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .dl h2 { font-size: 26px; }
  .dl .btn { margin-top: 18px; }
  .file { font-size: 12.5px; margin: 12px 0 0; overflow-wrap: anywhere; }
  .soon-line { margin-top: 18px; }
  .rel-line { margin-top: 18px; }
  .soon-wrap { padding-bottom: 110px; }
  .soon { padding: clamp(26px, 4vw, 44px); display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .soon .btn { margin-top: 8px; }

  .info { padding: clamp(56px, 7vw, 88px) var(--gutter) 110px; }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .info-card { padding: clamp(24px, 3vw, 34px); }
  .info-card h3 { font-size: 18px; margin: 4px 0 8px; }
  .info-card p { color: var(--text-2); font-size: 15.5px; }
  .info-card h3 + p { margin-bottom: 22px; }
  .points { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .points li { padding-left: 24px; position: relative; color: var(--text-2); font-size: 15.5px; }
  .points li::before { content: '✓'; position: absolute; left: 0; color: var(--cyan); }
  .lic { margin-top: 22px; }
  @media (max-width: 820px) { .dl-grid, .info-grid { grid-template-columns: 1fr; } }
</style>
