---
// The level of each channel at the clear film base, drawn like Obelisk's Live scan tuning
// bars. Values are % of the sensor's full range; the shaded band is the target for the
// brightest channel.
interface Props { title: string; r: number; g: number; b: number; status: string; ok?: boolean; band?: [number, number] }
const { title, r, g, b, status, ok = false, band = [85, 90] } = Astro.props;
const rows = [['R', r, 'r'], ['G', g, 'g'], ['B', b, 'b']] as const;
---
<div class="sl">
  <p class="sl-title">{title}</p>
  {rows.map(([label, v, c]) => (
    <div class="sl-row">
      <span class={`sl-k ${c}`}>{label}</span>
      <div class="sl-track" role="img" aria-label={`${label} channel at ${v.toFixed(1)}% of the sensor's range`}>
        <div class={`sl-bar ${c}`} style={`width:${v}%`}></div>
        <div class="sl-band" style={`left:${band[0]}%;width:${band[1] - band[0]}%`}></div>
      </div>
      <span class="sl-v">{v.toFixed(1)}%</span>
    </div>
  ))}
  <p class={`sl-status ${ok ? 'ok' : 'low'}`}>{status}</p>
</div>

<style>
  .sl { padding: 16px 18px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); }
  .sl-title { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--amber); margin: 0 0 12px; }
  .sl-row { display: grid; grid-template-columns: 14px 1fr 54px; gap: 10px; align-items: center; margin: 7px 0; }
  .sl-k { font-weight: 700; font-size: 13px; }
  .sl-k.r { color: #d07468; } .sl-k.g { color: #7fbf77; } .sl-k.b { color: #7d95dc; }
  .sl-track { position: relative; height: 14px; border-radius: 3px; background: #1a1c22; border: 1px solid var(--line); overflow: hidden; }
  .sl-bar { position: absolute; inset: 0 auto 0 0; }
  .sl-bar.r { background: #a85d55; } .sl-bar.g { background: #66985e; } .sl-bar.b { background: #5a70b4; }
  .sl-band { position: absolute; top: 0; bottom: 0; background: rgba(79, 200, 221, .22); }
  .sl-v { font-family: var(--mono); font-size: 13px; color: var(--text); text-align: right; }
  .sl-status { font-size: 13px; font-weight: 600; margin: 10px 0 0; }
  .sl-status.ok { color: #6fc27a; } .sl-status.low { color: var(--amber); }
</style>
