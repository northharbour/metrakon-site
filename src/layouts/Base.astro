---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { SITE, NAV, contactEmail, legalMissing } from '../site';
import { trialAvailable } from '../data/release';

// Never publish without a complete Impressum (§ 5 DDG): fail the production build.
if (import.meta.env.PROD && legalMissing().length) {
  throw new Error(`Impressum details missing in src/site.ts LEGAL: ${legalMissing().join(', ')}`);
}

interface Props { title?: string; description?: string; image?: string }
const { title, description = SITE.description, image = '/assets/og.jpg' } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — calibrated film negative conversion`;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const cta = SITE.stage === 'released'
  ? { href: '/pricing/', label: 'Get Obelisk' }
  : trialAvailable
    ? { href: '/download/', label: 'Download trial' }
    : { href: '/pricing/#early-access', label: 'Request early access' };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#070a12" />
  <link rel="icon" href="/assets/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/assets/icon-512.png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-in">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <Mark size={26} />
        <span>{SITE.name}</span>
      </a>
      <nav class="nav" aria-label="Main">
        {NAV.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <a class="btn btn-primary head-cta" href={cta.href}>{cta.label}</a>
      <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
        <span></span><span></span>
      </button>
    </div>
    <nav class="mnav" id="mnav" aria-label="Mobile">
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap foot-in">
      <div class="foot-brand">
        <a class="brand" href="/"><Mark size={22} /><span>{SITE.name}</span></a>
        <p class="muted small">Calibrated negative conversion for camera scanning.<br />A product of {SITE.publisher}.</p>
      </div>
      <div class="foot-cols">
        <div>
          <h4>Product</h4>
          <a href="/how-it-works/">How it works</a>
          <a href="/compare/">Comparison</a>
          <a href="/pricing/">Pricing</a>
          {trialAvailable && <a href="/download/">Download</a>}
        </div>
        <div>
          <h4>Company</h4>
          <a href="/pricing/#early-access">Early access</a>
          {contactEmail() && <a href={`mailto:${contactEmail()}`}>Contact</a>}
        </div>
        <div>
          <h4>Legal</h4>
          <a href="/impressum/">Impressum</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </div>
    </div>
    <div class="wrap"><div class="foot-base">
      <span>© {new Date().getFullYear()} {SITE.publisher}</span>
      <span class="muted">Product names in comparisons belong to their respective owners.</span>
    </div></div>
  </footer>

  <script>
    // Mobile menu
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const head = document.querySelector('.site-head');
    btn?.addEventListener('click', () => {
      const open = head!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    // Header picks up a surface once the page scrolls
    const onScroll = () => head!.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
    // Reveal-on-scroll
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>

  <style>
    .site-head { position: sticky; top: 0; z-index: 50; transition: background .2s, border-color .2s;
      border-bottom: 1px solid transparent; }
    .site-head.scrolled, .site-head.open { background: rgba(7,10,18,.82); backdrop-filter: blur(14px) saturate(140%);
      border-bottom-color: var(--line); }
    .head-in { display: flex; align-items: center; gap: 28px; height: 68px; }
    .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--text) !important;
      text-decoration: none !important; font-weight: 650; letter-spacing: .2em; text-transform: uppercase; font-size: 15px; }
    .nav { display: flex; gap: 26px; margin-left: auto; }
    .nav a { color: var(--text-2); font-size: 15px; font-weight: 500; }
    .nav a:hover, .nav a[aria-current] { color: var(--text); text-decoration: none; }
    .nav a[aria-current] { box-shadow: 0 2px 0 -0px var(--amber); }
    .head-cta { padding: 10px 18px; font-size: 14.5px; }
    .menu-btn { display: none; margin-left: auto; background: none; border: 0; width: 40px; height: 40px; cursor: pointer; position: relative; }
    .menu-btn span { position: absolute; left: 10px; right: 10px; height: 2px; background: var(--text); border-radius: 2px; transition: transform .2s; }
    .menu-btn span:first-child { top: 15px; } .menu-btn span:last-child { top: 23px; }
    .open .menu-btn span:first-child { transform: translateY(4px) rotate(45deg); }
    .open .menu-btn span:last-child { transform: translateY(-4px) rotate(-45deg); }
    .mnav { display: none; }
    @media (max-width: 820px) {
      .nav, .head-cta { display: none; }
      .menu-btn { display: block; }
      .open .mnav { display: flex; flex-direction: column; gap: 4px; padding: 8px var(--gutter) 22px; }
      .mnav a:not(.btn) { color: var(--text); padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
      .mnav .btn { margin-top: 16px; }
    }

    .site-foot { border-top: 1px solid var(--line); padding: 56px 0 36px; background: var(--bg-2); }
    .foot-in { display: flex; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
    .foot-brand p { margin-top: 14px; }
    .foot-cols { display: flex; gap: 64px; }
    .foot-cols h4 { font-size: 12.5px; font-family: var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); font-weight: 500; margin-bottom: 14px; }
    .foot-cols a { display: block; color: var(--text-2); font-size: 15px; margin-bottom: 9px; }
    .foot-base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 44px; padding-top: 22px;
      border-top: 1px solid var(--line); font-size: 13.5px; color: var(--dim); }
  </style>
</body>
</html>
